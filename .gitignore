# profitlovestax — specimen hygiene
# (This replaces the itsus root .gitignore, whose blanket *.cjs rule
#  silently ate load-bearing sources — including the CPL world host.
#  That rule is gone. The explicit exception below stands guard.)

node_modules/
**/node_modules/
.yarn
dist/
coverage/
.DS_Store
*.log
logs/
npm-debug.log*

# Secrets — never commit keys. The vault is the user's own.
.env
.env.*
!.env.example
**/.vault/
*.pem
*.key

# Runtime body data — generated by the living body; stays home.
# (The curated implant corpus under .seshat-brain/deep/ DOES ship —
#  it is the resident soul's memory, not runtime output.)
WORKBENCH_COMPLETE/workbench/.seshat-brain/deep-index.json
WORKBENCH_COMPLETE/workbench/.seshat-brain/pages/
WORKBENCH_COMPLETE/workbench/.seshat-brain/journals/
WORKBENCH_COMPLETE/workbench/.seshat-brain/quarantine/
WORKBENCH_COMPLETE/workbench/.seshat-brain/digestion-log.jsonl
WORKBENCH_COMPLETE/workbench/.seshat-brain/deep/session-outcomes/
WORKBENCH_COMPLETE/workbench/.seshat-vectors/
WORKBENCH_COMPLETE/workbench/.transformers-cache/
WORKBENCH_COMPLETE/workbench/node-runtime/
WORKBENCH_COMPLETE/gsk/data/
WORKBENCH_COMPLETE/gsk/tmp/
!**/.gitkeep

# Draft skills are not loadable skills.
WORKBENCH_COMPLETE/gsk/gsk-core/skill-drafts/

# The CPL world host is load-bearing source — never ignored, ever.
!**/genesis-host.cjs

# Form B of the Profit Bible (gsk/profit_bible.md) is NOT shipped:
# it carries credential-shaped strings (Phase 3 privacy gate class).
# Genesis keeps the clean Form A (profit-brain/THE-PROFIT-BIBLE.md);
# the Bible loader degrades gracefully without the Form B copy.
WORKBENCH_COMPLETE/gsk/profit_bible.md
